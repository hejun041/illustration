# KidStory 前端 — Caddy 配置示例
# 服务器：119.45.172.191（ubuntu）
# 站点根目录：/home/ubuntu/www/illustration/dist
#
# ── 首次安装 / 更新配置 ──
#   sudo cp /etc/caddy/Caddyfile /etc/caddy/Caddyfile.bak.$(date +%Y%m%d)
#   sudo nano /etc/caddy/Caddyfile          # 合并下方 www.kidstory.cc 块
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#   sudo systemctl status caddy
#
# ── 要点 ──
#   1. @static 必须在 SPA fallback 之前，否则缺失 /js/*.js 会返回 index.html → ChunkLoadError
#   2. try_files 支持 Vue History 路由（/books、/blog/xxx 等）
#   3. api.kidstory.cc 由后端 Koa 单独处理，不在此文件

# 裸域名 → www
kidstory.cc {
	redir https://www.kidstory.cc{uri} permanent
}

www.kidstory.cc {
	encode zstd gzip
	root * /home/ubuntu/www/illustration/dist
	@private path /creation-studio /creation-studio/* /user /user/* /member/* /wechat/callback /forgot-password
	header @private X-Robots-Tag "noindex, follow"

	# 静态资源：直接 file_server，禁止 fallback 到 index.html
	# 抓取入口单独处理，避免落入应用服务或静态资源长期缓存规则。
	@crawlFiles path /robots.txt /sitemap.xml /sitemap-pages.xml
	handle @crawlFiles {
		header Cache-Control "no-cache, must-revalidate"
		file_server
	}
	@static path /img/* /images/* /blog-assets/* /fonts/* /js/* /css/* /favicon* /android-chrome* /apple-touch-icon* /site.webmanifest /sitemap.xml /robots.txt
	handle @static {
		file_server
	}

	# 公开内容实时渲染；仅已知 Vue 路由返回应用外壳，其他地址返回真实 404。
	# 必须先启动 deploy/kidstory-seo.service，再切换此配置。
	handle {
		reverse_proxy 127.0.0.1:4100
	}

	@hashedAssets path_regexp hashedAssets ^/(js|css|img|fonts)/.*\.[a-f0-9]{8}\.[^/]+$
	header @hashedAssets Cache-Control "public, max-age=31536000, immutable"

	# 缓存：index.html / sitemap / robots 不长期缓存，便于 Google 重新抓取
	header /index.html Cache-Control "no-cache, no-store, must-revalidate"
	header /app.html Cache-Control "no-cache, no-store, must-revalidate"
	header /ai-picture-book* Cache-Control "no-cache, must-revalidate"
	header /guides/ai-picture-book-tutorial* Cache-Control "no-cache, must-revalidate"
	header /sitemap.xml Cache-Control "no-cache, must-revalidate"
	header /robots.txt Cache-Control "no-cache, must-revalidate"


}

# ── 若 api.kidstory.cc 也在同一台 Caddy，可参考（按实际后端端口修改）──
# api.kidstory.cc {
# 	reverse_proxy 127.0.0.1:3000
# }
